# ============================================================
# GBF Cache - repository root .gitignore
# ============================================================

# ---------- OS / editors ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db
*.swp
*.swo
*~
.idea/
*.iml
.vscode/
.history/

# ---------- Secrets / local configuration ----------
local.properties
*.keystore
*.jks
*.p12
signing.properties
secrets.properties
.env
.env.*

# ---------- Local Gradle distributions (re-downloadable, ~300MB) ----------
/gradle-8.10.2/
/gradle-9.7.1/

# ---------- Gradle / Android build caches and outputs ----------
.gradle/
build/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
*.hprof
hs_err_pid*
replay_pid*
gradle-daemon-jvm.properties
gradle-app.setting
.gradletasknamecache

# Android packaging / release artifacts
*.apk
*.aab
*.ap_
*.aar
outputs/
/dist/

# Native libraries extracted from the CMFA release APK (see BUILD.md)
/third_party/cmfa-aar/core/src/main/jniLibs/**/*.so

# ---------- Go build artifacts ----------
/core/bin/
/core/release/
*.exe
*.test
*.out

# ---------- Node / frontend ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
coverage/

# ---------- Runtime generated files ----------
/core/certs/
/core/config.json
*.log
*.tmp

# ---------- Python (upstream scripts may use it) ----------
__pycache__/
*.py[cod]
.venv/
venv/
